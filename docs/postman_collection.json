                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fiction\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 409\", function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Error message about duplicate\", function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.message).to.include(\"already exists\");",
                  "});"
                ],
