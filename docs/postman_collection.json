              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fantasy Updated\",\n  \"description\": \"Updated description\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/{{genreId}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genreId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Genre name updated\", function () {",
                  "  pm.expect(pm.response.json().name).to.equal(\"Fantasy Updated\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Genre with Duplicate Name (should fail)",
          "request": {
            "method": "PATCH",
            "header": [
              {
