# PostgreSQL connection string (Neon)
# Used by NestJS runtime and the seed script.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Unpooled/direct connection string (Neon)
# Used by Prisma migrations/datasource configuration in prisma.config.ts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional: NestJS HTTP port
PORT=3000
